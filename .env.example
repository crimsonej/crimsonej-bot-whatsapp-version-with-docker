# ───────────────────────────────────────────────────────────────────────────────
# 🤖 CRIMSONEJ — COMPLETE CLOUD & LOCAL DEPLOYMENT ENVIRONMENT VARIABLES
# ───────────────────────────────────────────────────────────────────────────────
# Copy these key-value pairs into your Railway / Render / HuggingFace / Docker
# environment variables tab, or into a local .env file.
# ───────────────────────────────────────────────────────────────────────────────

# ── 1. AI PROVIDER API KEYS (Required for AI features) ──
# Get NVIDIA key from https://build.nvidia.com (Free credits)
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY

# Get Groq key from https://console.groq.com (Fast free tier LLMs)
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY

# Get HuggingFace token from https://huggingface.co/settings/tokens (Optional image gen fallback)
HF_API_KEY=hf_YOUR_HUGGINGFACE_TOKEN

# ── 2. CREATOR & ADMIN IDENTIFIER ──
# Your personal WhatsApp phone number (with country code, digits only)
CREATOR_PHONE=256742184690
OWNER_JID=256742184690@s.whatsapp.net

# ── 3. AI MODEL CONFIGURATION ──
# Primary vision & chat model
MODEL=meta/llama-3.2-90b-vision-instruct
ACTIVE_MODEL=meta/llama-3.2-90b-vision-instruct

# Fast scout model for quick queries & classification
SCOUT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ── 4. GITHUB INTEGRATION & AUTOMATED BACKUP (Optional) ──
# GitHub Personal Access Token (with 'repo' scope) for backup & GitHub tools
GITHUB_TOKEN=ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN

# GitHub repo for automated sqlite database & memory backups (e.g., username/repo)
GITHUB_BACKUP_REPO=crimsonej/crimsonej-data

# ── 5. SECURITY & BRIDGE AUTHENTICATION ──
# Shared secret bearer token securing internal Python <-> Node.js communication
CRIMSON_API_TOKEN=generate_or_paste_a_secure_32char_token_here
BRIDGE_API_TOKEN=generate_or_paste_a_secure_32char_token_here

# ── 6. SERVER PORTS & NETWORKING ──
# WhatsApp Node.js Bridge HTTP Port
PORT=7860

# Python Flask AI Engine HTTP Port
BOT_PORT=5000

# Endpoint where WhatsApp Bridge sends incoming messages
AI_SERVER=http://crimson-bot:5000/reply

# Endpoint where Python AI Server calls WhatsApp Bridge back
BRIDGE_BASE_URL=http://whatsapp-bridge:7860

# Deployment environment mode ('docker' or 'local')
DEPLOY_MODE=docker

# ── 7. STORAGE & DIRECTORIES ──
# Base directory for persistent SQLite DB and JSON states
DATA_DIR=/data

# WhatsApp Baileys session authentication folder
AUTH_DIR=/data/auth_info_baileys

# Directory for generated images, charts, documents, and media
MEDIA_ROOT=/media

# Redis server connection URL (for async job queues & caching)
REDIS_URL=redis://redis:6379/0

# ── 8. MEDIA & FEATURE SETTINGS (Optional) ──
# Optional YouTube cookies string or path for yt-dlp age-restricted downloads
YT_COOKIES=

# Automated daily trading briefing settings (pre_london=07:30 UTC/EAT, eod=21:30 UTC/EAT)
TRADING_BRIEFING_ENABLED=true
TRADING_BRIEFING_PRE_LONDON=07:30
TRADING_BRIEFING_EOD=21:30

# System environment overrides
PYTHONUNBUFFERED=1
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
CHROME_BIN=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

