# ─── Crimsonej Environment Variables ─────────────────────────────────────────

# ── 1. API Keys (Required for AI Features) ──
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY
HF_API_KEY=

# Optional YouTube cookies: path to a Netscape cookies.txt file, or raw
# Netscape text, browser-export JSON, or a Cookie header string.
YT_COOKIES=

# Optional public origin for temporary static app previews.
PUBLIC_BASE_URL=

# ── 2. Creator Settings ──
CREATOR_PHONE=123456789012

# ── 3. AI Model Choice ──
MODEL=meta/llama-3.2-90b-vision-instruct

# ── 4. Optional GitHub Backups & Tools ──
GITHUB_TOKEN=
GITHUB_BACKUP_REPO=


