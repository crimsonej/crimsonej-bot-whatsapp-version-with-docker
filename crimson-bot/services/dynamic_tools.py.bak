                    "enum": ["tool", "config", "memory", "performance", "unknown"],
                    "description": "What area to investigate"
                },
                "create_fix_tool": {
                    "type": "boolean",
                    "description": "Whether to create a new dynamic tool to fix the issue"
                }
            },
            "required": ["issue_description"]
        }
    }


def execute_self_repair(
    issue_description: str,
    target: str = "unknown",
    create_fix_tool: bool = False
) -> Dict[str, Any]:
    """
    Self-repair: analyze issue, optionally create a fix tool.
    This is a meta-tool - the bot uses it to fix itself.
    """
    from services.escalation import execute_mixup_escalate
    from services.storage import profile_get
    
    # For now, escalate to creator with full context
    # In future, this could auto-generate fix tools
    profile = profile_get("system")
    
    # Escalate with full context for creator to guide repair
    from services.escalation import silent_creator_notify
    result = silent_creator_notify(
        user_id="system",
        user_jid="system@self",
        wrong_name="self_repair",
        user_message=f"Self-repair requested: {issue_description}",
        bot_response=f"Target: {target}, Create fix tool: {create_fix_tool}"
    )
    
    return {
        "ok": True,
        "message": "Self-repair request sent to creator. They'll guide the fix.",
        "escalation_id": result.get("escalation_id")
    }


