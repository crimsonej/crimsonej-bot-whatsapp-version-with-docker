#!/usr/bin/env python3
"""Navigable interactive configuration wizard for Crimsonej."""

import json
import os
import secrets
import sys
import urllib.request
from getpass import getpass

ROOT_DIR = os.path.dirname(os.path.abspath(__file__))
BOT_DIR = os.path.join(ROOT_DIR, "crimson-bot")
BRIDGE_DIR = os.path.join(ROOT_DIR, "whatsapp-bridge")
DEFAULT_MODEL = "nvidia/nemotron-3-super-120b-a12b"
CHAT_WORDS = ("instruct", "chat", "versatile", "nemotron", "mistral", "compound", "gpt-oss")
SKIP_WORDS = ("whisper", "embed", "guard", "rerank", "bge-", "fuyu", "neva", "kosmos", "parakeet", "canary", "starcoder", "codestral")


def header(title):
    print(f"\n\033[1;36m--- {title} ---\033[0m")


def ask(label, default=""):
    suffix = f" [{default}]" if default else ""
    value = input(f"  {label}{suffix}: ").strip()
    return value or default


def secret(label, current=""):
    state = "configured" if current else "not set"
    value = getpass(f"  {label} [{state}] (Enter keeps current): ").strip()
    return current if not value else value


def read_env(path):
    values = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, value = line.split("=", 1)
                    values[key] = value
    except OSError:
        pass
    return values


def write_env(path, values):
    with open(path, "w", encoding="utf-8") as fh:
        for key, value in values.items():
            if value != "":
                fh.write(f"{key}={value}\n")
    os.chmod(path, 0o600)


def port(label, current):
    while True:
        value = ask(label, str(current))
        try:
            result = int(value)
            if 1 <= result <= 65535:
                return result
        except ValueError:
            pass
        print("  Use a port from 1 to 65535.")


def fetch_models(nvidia_key, groq_key):
    models = []
    sources = (
        ("NVIDIA", nvidia_key, "https://integrate.api.nvidia.com/v1/models"),
        ("Groq", groq_key, "https://api.groq.com/openai/v1/models"),
    )
    for provider, key, url in sources:
        if not key:
            continue
        print(f"  Fetching {provider} models...", end="", flush=True)
        try:
            request = urllib.request.Request(url, headers={"Authorization": f"Bearer {key}"})
            with urllib.request.urlopen(request, timeout=10) as response:
                data = json.loads(response.read().decode("utf-8"))
            found = []
            for item in data.get("data", []):
                model_id = item.get("id", "")
                lowered = model_id.lower()
                if model_id and any(word in lowered for word in CHAT_WORDS) and not any(word in lowered for word in SKIP_WORDS):
                    found.append((model_id, provider))
            models.extend(found)
            print(f" ok ({len(found)} models)")
        except Exception as exc:
            print(f" unavailable ({exc})")
    priority = ["meta/llama-3.2-90b-vision-instruct", "nv-mistralai/mistral-nemo-12b-instruct", "llama-3.3-70b-versatile"]
    models.sort(key=lambda item: (priority.index(item[0]) if item[0] in priority else len(priority), item[0]))
    return models


def choose_model(settings):
    models = fetch_models(settings["nvidia_key"], settings["groq_key"])
    if not models:
        return ask("Model ID", settings["model"])
    print("\n  Available chat models:")
    shown = models[:15]
    for index, (model_id, provider) in enumerate(shown, 1):
        print(f"  {index:>2}. [{provider}] {model_id}")
    choice = ask("Model number or custom model ID", "1")
    if choice.isdigit() and 1 <= int(choice) <= len(shown):
        return shown[int(choice) - 1][0]
    return choice


def configure_providers(settings):
    header("Provider Keys")
    settings["nvidia_key"] = secret("NVIDIA API key", settings["nvidia_key"])
    settings["groq_key"] = secret("Groq API key", settings["groq_key"])
    settings["hf_key"] = secret("HuggingFace API key", settings["hf_key"])
    print("  Keys updated. They will be stored in crimson-bot/.env only.")


def configure_runtime(settings):
    header("Runtime")
    mode = ask("Deployment mode (local/docker)", settings["mode"]).lower()
    while mode not in {"local", "docker"}:
        print("  Choose local or docker.")
        mode = ask("Deployment mode (local/docker)", settings["mode"]).lower()
    settings["mode"] = mode
    settings["bot_port"] = port("Python bot port", settings["bot_port"])
    settings["bridge_port"] = port("WhatsApp bridge port", settings["bridge_port"])


def save(settings):
    bot_host = "crimson-bot" if settings["mode"] == "docker" else "127.0.0.1"
    bridge_host = "whatsapp-bridge" if settings["mode"] == "docker" else "127.0.0.1"
    owner = settings["creator_phone"]
    owner_jid = f"{owner}@s.whatsapp.net" if owner and "@" not in owner else owner

    write_env(os.path.join(BOT_DIR, ".env"), {
        "BOT_PORT": settings["bot_port"],
        "BRIDGE_BASE_URL": f"http://{bridge_host}:{settings['bridge_port']}",
        "MODEL": settings["model"],
        "CRIMSON_API_TOKEN": settings["api_token"],
        "NVIDIA_API_KEY": settings["nvidia_key"],
        "GROQ_API_KEY": settings["groq_key"],
        "HF_API_KEY": settings["hf_key"],
        "CREATOR_PHONE": settings["creator_phone"],
    })
    write_env(os.path.join(BRIDGE_DIR, ".env"), {
        "PORT": settings["bridge_port"],
        "AI_SERVER": f"http://{bot_host}:{settings['bot_port']}/reply",
        "BOT_NAME": "crimsonej",
        "CRIMSON_API_TOKEN": settings["api_token"],
    })

    provider = "groq" if settings["groq_key"] and ("versatile" in settings["model"] or "groq" in settings["model"].lower()) else "nvidia"
    scout = "nvidia/nemotron-3.5-lightning-30b-a3b" if provider == "nvidia" else DEFAULT_MODEL
    config = {
        "providers": {"nvidia": "", "groq": "", "huggingface": ""},
        "models": [
            {"id": settings["model"], "provider": provider, "tier": "primary"},
            {"id": scout, "provider": "nvidia", "tier": "scout"},
            {"id": "llama-3.3-70b-versatile", "provider": "groq", "tier": "fallback"},
        ],
        "active_model": settings["model"],
        "port": settings["bot_port"],
        "owner_jid": owner_jid,
        "relevance_threshold": 0.08,
        "session_ttl": 1800,
    }
    with open(os.path.join(BOT_DIR, "config.json"), "w", encoding="utf-8") as fh:
        json.dump(config, fh, indent=2)


def menu(settings):
    while True:
        header("Crimsonej Setup")
        print(f"  1. Provider keys   {'ready' if any((settings['nvidia_key'], settings['groq_key'], settings['hf_key'])) else 'not configured'}")
        print(f"  2. AI model        {settings['model']}")
        print(f"  3. Runtime         {settings['mode']} | bot {settings['bot_port']} | bridge {settings['bridge_port']}")
        print(f"  4. Identity        {settings['creator_phone'] or 'not set'}")
        print("  5. Save and exit")
        print("  6. Exit without saving")
        choice = input("\n  Select a section [1-6]: ").strip().lower()
        if choice == "1":
            configure_providers(settings)
        elif choice == "2":
            header("AI Model")
            settings["model"] = choose_model(settings)
        elif choice == "3":
            configure_runtime(settings)
        elif choice == "4":
            header("Identity")
            settings["creator_phone"] = ask("Creator WhatsApp phone", settings["creator_phone"])
        elif choice == "5":
            save(settings)
            print("\n  Saved. Run `crimsonej start` to launch the bot.\n")
            return
        elif choice == "6":
            print("\n  Nothing was changed.\n")
            return
        else:
            print("  Choose 1-6.")


def main():
    bot_values = read_env(os.path.join(BOT_DIR, ".env"))
    bridge_values = read_env(os.path.join(BRIDGE_DIR, ".env"))
    settings = {
        "nvidia_key": bot_values.get("NVIDIA_API_KEY", os.getenv("NVIDIA_API_KEY", "")),
        "groq_key": bot_values.get("GROQ_API_KEY", os.getenv("GROQ_API_KEY", "")),
        "hf_key": bot_values.get("HF_API_KEY", os.getenv("HF_API_KEY", "")),
        "model": bot_values.get("MODEL", os.getenv("MODEL", DEFAULT_MODEL)),
        "mode": os.getenv("DEPLOY_MODE", "local"),
        "bot_port": int(bot_values.get("BOT_PORT", os.getenv("BOT_PORT", "5000"))),
        "bridge_port": int(bridge_values.get("PORT", os.getenv("PORT", "7860"))),
        "creator_phone": bot_values.get("CREATOR_PHONE", ""),
        "api_token": bot_values.get("CRIMSON_API_TOKEN", bridge_values.get("CRIMSON_API_TOKEN", "")) or secrets.token_urlsafe(32),
    }
    menu(settings)


if __name__ == "__main__":
    main()
