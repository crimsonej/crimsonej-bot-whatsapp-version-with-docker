#!/usr/bin/env bash
# crimsonej · Master Command Line Interface

ROOT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
PYTHON_BIN="$ROOT_DIR/crimson-bot/venv/bin/python"

if [ ! -f "$PYTHON_BIN" ]; then
    PYTHON_BIN="python3"
fi

COMMAND="${1:-status}"

case "$COMMAND" in
    start)
        "$PYTHON_BIN" "$ROOT_DIR/orchestrator.py" start
        ;;
    stop)
        "$PYTHON_BIN" "$ROOT_DIR/orchestrator.py" stop
        ;;
    restart)
        "$PYTHON_BIN" "$ROOT_DIR/orchestrator.py" restart
        ;;
    status)
        "$PYTHON_BIN" "$ROOT_DIR/orchestrator.py" status
        ;;
    logs)
        "$PYTHON_BIN" "$ROOT_DIR/orchestrator.py" logs "${2:-all}"
        ;;
    setup|config)
        "$PYTHON_BIN" "$ROOT_DIR/setup"
        ;;
    reindex)
        echo "Rebuilding RAG Knowledge Index..."
        cd "$ROOT_DIR/crimson-bot"
        "$PYTHON_BIN" bot.py server --reindex
        ;;
    help|--help|-h)
        echo "🤖 Crimsonej CLI Usage:"
        echo "  crimsonej start    - Launch AI Server & WhatsApp Bridge"
        echo "  crimsonej stop     - Stop all running bot processes"
        echo "  crimsonej restart  - Restart both services (picks up code changes)"
        echo "  crimsonej status   - Check status of both services and health"
        echo "  crimsonej logs     - Tail live logs (use 'crimsonej logs bot' or 'crimsonej logs bridge')"
        echo "  crimsonej setup    - Run interactive API key configuration wizard"
        echo "  crimsonej reindex  - Rebuild RAG Knowledge Base vector index"
        ;;
    *)
        echo "Unknown command: $COMMAND"
        echo "Run 'crimsonej help' for available commands."
        exit 1
        ;;
esac
